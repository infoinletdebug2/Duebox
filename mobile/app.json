{
  "expo": {
    "name": "Duebox",
    "slug": "duebox",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "duebox",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F5F3F8",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#2E1A47",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.duebox.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Duebox uses the camera to scan letters and bills so it can find their deadlines.",
        "NSPhotoLibraryUsageDescription": "Duebox lets you choose photos of letters and bills so it can find their deadlines.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.duebox.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E1A47"
      },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#2E1A47",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Duebox uses the camera to scan letters and bills so it can find their deadlines.",
          "photosPermission": "Duebox lets you choose photos of letters and bills so it can find their deadlines."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#2E1A47",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#141019"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {}
  }
}
