{
  "expo": {
    "name": "Due Meld",
    "slug": "duebox",
    "owner": "patheditor1",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "duemeld",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F5F3F8",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#2E1A47",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.infoinlet.duemeld",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Due Meld uses the camera to scan letters and bills so it can find their deadlines.",
        "NSPhotoLibraryUsageDescription": "Due Meld lets you choose photos of letters and bills so it can find their deadlines.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.infoinlet.duemeld",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D154A"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#2E1A47",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Due Meld uses the camera to scan letters and bills so it can find their deadlines.",
          "photosPermission": "Due Meld lets you choose photos of letters and bills so it can find their deadlines."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#2E1A47",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#141019"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ccf56df5-6706-49ed-bae7-e3dd0d3583d7"
      }
    }
  }
}
