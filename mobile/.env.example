# Duebox mobile — copy to .env (gitignored). Metro INLINES these at build
# time: restart with `npx expo start -c` after any change. Everything here
# ships inside the app bundle — ids and labels only, never a secret.
# The phone holds no Xenition package and no key; it only talks to the worker.

# The worker. Leave empty in development: the app derives the dev machine's
# LAN address from Expo and uses EXPO_PUBLIC_API_PORT.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=8787

# Must match backend/.dev.vars PRO_*_ID exactly, and exist in both stores.
EXPO_PUBLIC_PRO_MONTHLY_ID=duebox_pro_monthly
EXPO_PUBLIC_PRO_YEARLY_ID=duebox_pro_yearly
# The store's intro offer on yearly. Copy only — the store decides.
EXPO_PUBLIC_TRIAL_DAYS=7
# $34.99/yr vs $4.99/mo. A label, not a calculation. 0 hides the badge.
EXPO_PUBLIC_YEARLY_SAVING_PERCENT=41

# Free-tier copy before the server answers (the server decides).
EXPO_PUBLIC_FREE_OPEN_ITEMS=5
EXPO_PUBLIC_FREE_SCANS=3

EXPO_PUBLIC_SUPPORT_EMAIL=contact@infoinlet.com
EXPO_PUBLIC_WEBSITE_URL=https://duebox.app
EXPO_PUBLIC_APPLE_APP_ID=
EXPO_PUBLIC_ANDROID_PACKAGE=app.duebox.mobile
# EAS project id — required for push tokens in a dev/store build.
EXPO_PUBLIC_EAS_PROJECT_ID=

# One-time welcome offer after setup — must match backend OFFER_*_ID.
EXPO_PUBLIC_OFFER_MONTHLY_ID=duebox_pro_monthly_offer
EXPO_PUBLIC_OFFER_YEARLY_ID=duebox_pro_yearly_offer
# Copy label only (the store's prices decide). 0 hides the discount wording.
EXPO_PUBLIC_OFFER_PERCENT=20

# Meta ads measurement (react-native-fbsdk-next). Both empty = off: no SDK
# config in the build, no tracking prompt. Rebuild after setting them.
EXPO_PUBLIC_META_APP_ID=
EXPO_PUBLIC_META_CLIENT_TOKEN=
